# Modo demonstração: usa dados de exemplo no navegador, sem backend.
# Troque para "false" quando o backend do agente estiver rodando.
VITE_USE_MOCK=true

# Base das chamadas à API (padrão: /api, encaminhado pelo proxy do Vite em desenvolvimento).
# VITE_API_URL=/api

# Destino do proxy em desenvolvimento.
# VITE_PROXY_TARGET=http://localhost:8000
